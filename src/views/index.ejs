      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavDropdown">
       <!-- Alinea los enlaces del menú hacia la derecha. -->
      <ul class="navbar-nav ms-auto">
        
        <li class="nav-item">
          
