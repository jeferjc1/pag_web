    <img src="/img/new_logo_personal.png" alt="" class="w-25">
    <h1 class="display-1 my-5 text-uppercase fw-bold text-black">UNAD</h1>
    <!-- Permite volver a cargar la página de inicio. -->
    <a href="/" class="btn btn-primary w-25">Inicio</a>
    </div>
   </header>
    <marquee scrollamount="15">
      <h1>Buenos dias la hora es <%= hora%>
      </h1>
    </marquee>
    
<!-- Incluye el pie de página compartido. -->
<%- include('Partials/Footer') %>
