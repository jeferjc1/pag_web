          <a class="nav-link active" aria-current="page" href="/login">Inisio de sesion</a>
          <li class="nav-item">
          <a class="nav-link" href="/menu">Menu Empresarial</a>
        </li>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/contactos">Contactos</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/sobre_nosotros">Sobre nosotros</a>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Dropdown link
          </a>
          <!-- Menú desplegable con accesos rápidos a las vistas. -->
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/">Inicio</a></li>
            <li><a class="dropdown-item" href="/contactos">Contactos</a></li>
            <li><a class="dropdown-item" href="/sobre_nosotros">Sobre nosotros</a></li>
